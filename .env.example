# Project Settings → API / API Keys, no painel do Supabase.
#
# O Supabase renomeou as chaves: a "publishable key" (sb_publishable_...) é a
# antiga anon key, e a "secret key" (sb_secret_...) é a antiga service_role.
# As chaves legadas em formato JWT (eyJhbGciOi...) continuam funcionando — se
# você estiver num projeto antigo, use anon no lugar da publishable e
# service_role no lugar da secret.

# Client-side (pode ir pro bundle; sujeita a RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# SÓ SERVIDOR — ignora RLS. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Usado apenas por scripts/rls-check.ts (usuários de teste do seed)
RLS_CHECK_PASSWORD=efeitos123
